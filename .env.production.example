APP_ENV=production
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_TTL_SECONDS=86400
AUTH_COOKIE_NAME=access_token
AUTH_COOKIE_SECURE=true
CSRF_COOKIE_NAME=csrf_token
FORCE_HTTPS=true
TRUST_PROXY=true
ALLOWED_HOSTS=app.example.com
API_CORS_ORIGINS=https://app.example.com
FRONTEND_BASE_URL=https://app.example.com
PASSWORD_RESET_BASE_URL=https://app.example.com
PASSWORD_RESET_TTL_MINUTES=60

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=notification@example.com
SMTP_PASSWORD=replace-with-the-smtp-password
SMTP_FROM=notification@example.com
SMTP_USE_TLS=true

PG_DB=benjamin_immobilier
PG_USER=benjamin_app
PG_PASSWORD=replace-with-a-random-database-password
PG_HOST=database.internal
PG_PORT=5432

MAX_FAILED_LOGIN_ATTEMPTS=5
MAX_FAILED_LOGIN_ATTEMPTS_PER_IP=20
LOGIN_ATTEMPT_WINDOW_MINUTES=15
ACCOUNT_LOCK_MINUTES=15

ADDRESS_API_URL=https://data.geopf.fr/geocodage/search
CADASTRE_API_URL=https://apicarto.ign.fr/api/cadastre/parcelle
GPU_API_BASE_URL=https://apicarto.ign.fr/api/gpu
ENABLE_GPU_ENRICHMENT=false
MIN_GEOCODE_SCORE=0.45
ENRICHMENT_SSL_VERIFY=true
