{
    "name": "Annonces Leboncoin",
    "baseSelector": "article[data-test-id='ad']",
    "fields": [
        {
            "name": "title",
            "selector": "p[aria-label*='Maison'], p[aria-label*='Appartement'], p[aria-label*='Terrain'], p.text-body-2.font-bold",
            "type": "text"
        },
        {
            "name": "price",
            "selector": "p[data-test-id='price'] span",
            "type": "text"
        },
        {
            "name": "price_square_meter",
            "selector": "div.text-caption p",
            "type": "text"
        },
        {
            "name": "address",
            "selector": "p.text-caption",
            "type": "text"
        },
        {
            "name": "url",
            "selector": "a[href^='/ad/']",
            "type": "attribute",
            "attribute": "href"
        },
        {
            "name": "energy_class",
            "selector": "img[alt*='Classe']",
            "type": "attribute",
            "attribute": "alt"
        },
        {
            "name": "agency",
            "selector": "p[data-test-id='pro-store-name'] strong",
            "type": "text"
        }
    ]
}