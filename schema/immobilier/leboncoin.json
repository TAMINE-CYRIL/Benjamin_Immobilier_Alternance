{
    "name": "Annonces Leboncoin",
    "baseSelector": "div[data-qa-id='aditem_container']",
    "fields": [
        {
            "name": "title",
            "selector": "p[aria-label*='pièce'], p[aria-label*='mètres carrés'], p[class*='text-body-2'][class*='font-bold']",
            "type": "text"
        },
        {
            "name": "price",
            "selector": "p[class*='text-callout'] span",
            "type": "text"
        },
        {
            "name": "price_square_meter",
            "selector": "div[class*='text-caption'][class*='text-on-background'] p",
            "type": "text"
        },
        {
            "name": "address",
            "selector": "p[aria-hidden='true'][class*='text-caption'][class*='text-on-surface']",
            "type": "text"
        },
        {
            "name": "url",
            "selector": "a[aria-label='Voir l’annonce'], a[href^='/ad/ventes_immobilieres/']",
            "type": "attribute",
            "attribute": "href"
        },
        {
            "name": "energy_class",
            "selector": "img[alt*='Classe'], [aria-label*='Classe énergie'], [aria-label*='DPE']",
            "type": "attribute",
            "attribute": "alt"
        },
        {
            "name": "agency",
            "selector": "p[data-test-id='pro-store-name'] strong",
            "type": "text"
        }
    ]
}
