{
  "name": "Espace Atypiques Immobilier",
  "baseSelector": "div.preview-annonce",
  "fields": [
    { 
      "name": "title", 
      "selector": ".infos .titre a", 
      "type": "text" 
    },
    { 
      "name": "url", 
      "selector": ".infos .titre a", 
      "type": "attribute", 
      "attribute": "href" 
    },
    { 
      "name": "address", 
      "selector": ".infos .localisation .ville", 
      "type": "text" 
    },
    {
      "name": "surface", 
      "selector": ".infos span:-soup-contains('M2'), .infos span:-soup-contains('m²'), .infos span:-soup-contains('M²')", 
      "type": "text" 
    },
    {
      "name": "price", 
      "selector": ".infos span:-soup-contains('€')", 
      "type": "text"
    }
  ]
}